# Bucket Service Configuration
BUCKET_SERVICE_PORT=8084
BUCKET_SERVICE_HOST=0.0.0.0
ENVIRONMENT=development

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=bucket_user
DB_PASSWORD=bucket_password
DB_NAME=bucket_service
DB_SSLMODE=disable

# AWS S3 Configuration
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=example-access-key-id
S3_SECRET_ACCESS_KEY=example-secret-access-key
S3_BUCKET_PREFIX=study-platform

# Bucket Names (videos handled by Cloudflare Stream)
S3_BUCKET_FILES=study-platform-files-khoipn-dev
S3_BUCKET_DOCUMENTS=study-platform-documents-khoipn-dev
S3_BUCKET_IMAGES=study-platform-images-khoipn-dev
S3_BUCKET_AVATARS=study-platform-avatars-khoipn-dev
S3_BUCKET_COURSE_MATERIALS=study-platform-course-materials-khoipn-dev

# File Upload Limits (no video files)
MAX_FILE_SIZE=1073741824  # 1GB (reduced since no large video files)
MULTIPART_THRESHOLD=104857600  # 100MB
PART_SIZE=5242880  # 5MB
MAX_UPLOAD_PARTS=1000
PRESIGNED_URL_EXPIRATION=3600  # 1 hour
CHUNK_SIZE=1048576  # 1MB

# Allowed File Types (no video formats)
ALLOWED_DOCUMENT_TYPES=pdf,doc,docx,ppt,pptx,xls,xlsx,txt,rtf
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif,webp,svg,bmp
ALLOWED_ARCHIVE_TYPES=zip,rar,7z,tar,gz

# Security Configuration
JWT_SECRET=your-super-secret-jwt-key-min-256-bits
CORS_ORIGINS=http://localhost:3000
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Origin,Content-Type,Accept,Authorization

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=/app/logs/bucket-service.log