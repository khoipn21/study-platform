FROM golang:1.23-alpine AS builder

WORKDIR /app

# Install git and ca-certificates
RUN apk add --no-cache git ca-certificates

# Copy go mod files
COPY course-service/go.mod course-service/go.sum ./
COPY pkg/ ../pkg/

# Download dependencies
RUN go mod download

# Copy source code
COPY course-service/ .

# Build the application
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o main ./cmd/

# Final stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates

WORKDIR /root/

# Copy the binary from builder
COPY --from=builder /app/main .

# Install grpc_health_probe
RUN apk add --no-cache curl && \
    curl -L https://github.com/grpc-ecosystem/grpc-health-probe/releases/latest/download/grpc_health_probe-linux-amd64 -o grpc_health_probe && \
    chmod +x grpc_health_probe && \
    mv grpc_health_probe /usr/local/bin/

EXPOSE 8080

CMD ["./main"]